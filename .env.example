# Sign up free at https://www.emailjs.com, create an email service + template,
# then copy the three values below into a new file named ".env" (not .env.example).
# Also add these same three as environment variables in your Netlify site settings
# (Site configuration → Environment variables) before deploying.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_ACCESS_TOKEN=
